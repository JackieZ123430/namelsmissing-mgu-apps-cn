{
  "id": "light_flasher",
  "title": "Light Flasher",
  "description": "Passive startup monitor, bounded manual parked test, actual two-request TASU transport test. No OEM suppression.",
  "version": "0.1.7",
  "vendor": "custom",
  "loggingId": "OLF1",
  "iconGlyph": "LF",
  "showRepoCredits": false,
  "signals": {
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": [
        "sendTasuRequest"
      ],
      "_broadcasts": [
        "sendTasuResponse"
      ]
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs",
      "statusLightStatus": "rs"
    },
    "de.bmw.infrastructure.VehicleInformation": {
      "statusGearboxDrive": "s",
      "DataPowerTrain2": "s"
    }
  },
  "settings": [
    {
      "key": "enabled",
      "label": "Enable diagnostic mode (no lamp commands)",
      "type": "bool",
      "default": false
    },
    {
      "key": "backgroundMonitor",
      "label": "Background status monitor (read only)",
      "type": "bool",
      "default": true
    },
    {
      "key": "manualFlash",
      "label": "Enable manual parked flash (private property only)",
      "type": "bool",
      "default": false
    },
    {
      "key": "pattern",
      "label": "Flash pattern",
      "type": "choice",
      "default": "alternate",
      "options": [
        [
          "alternate",
          "Alternate L/R"
        ],
        [
          "double",
          "Double L/R"
        ],
        [
          "triple",
          "Triple L/R"
        ],
        [
          "together",
          "Both together"
        ]
      ]
    },
    {
      "key": "interval",
      "label": "Requested step interval",
      "type": "choice",
      "default": "100",
      "options": [
        [
          "20",
          "20 ms (transport test only)"
        ],
        [
          "40",
          "40 ms (transport test only)"
        ],
        [
          "60",
          "60 ms (transport test only)"
        ],
        [
          "80",
          "80 ms (transport test only)"
        ],
        [
          "100",
          "100 ms"
        ],
        [
          "150",
          "150 ms"
        ],
        [
          "200",
          "200 ms"
        ],
        [
          "300",
          "300 ms"
        ],
        [
          "500",
          "500 ms"
        ],
        [
          "1000",
          "1000 ms"
        ]
      ]
    },
    {
      "key": "hold",
      "label": "Flash duration",
      "type": "choice",
      "default": "3000",
      "options": [
        [
          "2000",
          "2 s"
        ],
        [
          "3000",
          "3 s"
        ],
        [
          "4000",
          "4 s"
        ],
        [
          "5000",
          "5 s"
        ]
      ]
    }
  ],

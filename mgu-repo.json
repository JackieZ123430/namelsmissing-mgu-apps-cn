{
  "schema": 1,
  "components": [
    {
      "id": "gif_home",
      "kind": "app",
      "path": "apps/gif_home",
      "manifest": "app.zh-CN.json",
      "title": "GIF 首页组件",
      "description": "在 iDrive 首页大磁贴中显示 GIF 动画，支持内置动画、手机扫码上传和显示设置。",
      "mguHmi": [
        "ID7"
      ],
      "requires": {
        "idrive7-renderd": "2.1.7",
        "mgu-inputgate": "1.0.0"
      },
      "icon": "icon.png",
      "build": {
        "python": "localization/build_zh_cn.py",
        "args": [
          "{id}"
        ],
        "sdk": "oap-sdk",
        "output": "dist/{id}@{version}.tgz",
        "shared": [
          "kit",
          "apps",
          "localization"
        ]
      }
    }
  ],
  "tools": [
    {
      "id": "mgu-video-net",
      "kind": "tool",
      "title": "Video Hub Network Bridge",
      "version": "0.1.0",
      "path": "native/video-net",
      "mguHmi": [
        "ID7"
      ],
      "uninstallable": true
    },
    {
      "id": "mgu-cluster-net",
      "kind": "tool",
      "title": "Custom Cluster Phone Port",
      "version": "0.1.0",
      "path": "native/cluster-net",
      "mguHmi": [
        "ID7"
      ],
      "uninstallable": true
    },
    {
      "id": "mgu-game-net",
      "kind": "tool",
      "title": "GameStation Phone Port",
      "version": "0.1.0",
      "path": "native/game-net",
      "mguHmi": [
        "ID7"
      ],
      "uninstallable": true
    },
    {
      "id": "mgu-phone-bridge",
      "kind": "tool",
      "title": "Phone Terminal Bridge",
      "version": "0.1.6",
      "path": "native/phone-bridge",
      "mguHmi": [
        "ID7"
      ],
      "uninstallable": true
    },
    {
      "id": "mgu-light-net",
      "kind": "tool",
      "title": "Light Show Phone Port",
      "version": "0.1.0",
      "path": "native/light-net",
      "mguHmi": [
        "ID7"
      ],
      "uninstallable": true
    },
    {
      "id": "mgu-equalizer-dsp",
      "kind": "tool",
      "title": "Equalizer PCM DSP",
      "version": "0.2.1",
      "path": "native/equalizer-dsp",
      "mguHmi": [
        "ID7"
      ],
      "uninstallable": true
    }
  ]
}
